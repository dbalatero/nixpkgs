#!/usr/bin/env python3
"""Name and configure a clone of the NixOS Proxmox base image."""

import argparse
import base64
import ipaddress
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
from urllib.parse import urlencode


BUILDER = "builder.vm.netcat.cloud"
BUILDER_KEY = "/root/.ssh/builder"
CLIENT_MODULE = "hosts/common/nix-build-client"


class BootstrapError(Exception):
  pass


def run(argv, *, cwd=None):
  result = subprocess.run(argv, cwd=cwd, text=True, capture_output=True)
  if result.returncode:
    raise BootstrapError(f"{' '.join(argv)} failed:\n{result.stderr.strip()}")
  return result.stdout


def nix_string(value):
  # JSON strings are valid Nix strings after disabling interpolation.
  return json.dumps(value, ensure_ascii=False).replace("${", "\\${")


def arguments(argv=None):
  raw = sys.argv[1:] if argv is None else argv
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("hostname", nargs="?", help="new single-label hostname")
  parser.add_argument("--description", default="NixOS homelab VM")
  parser.add_argument("--profile", choices=["headless"], default="headless")
  parser.add_argument("--static-ip", help="IPv4 address with prefix, or 'auto' to allocate from lab/network.json")
  parser.add_argument("--suggest-ip", action="store_true", help="print the next unrecorded static IP from the local inventory and exit")
  parser.add_argument("--gateway", help="IPv4 gateway; defaults to the homelab gateway for lab addresses")
  parser.add_argument("--dns", action="append", default=[], help="DNS IP address; repeatable, defaults to homelab DNS for lab addresses")
  parser.add_argument("--interface", help="guest interface for static networking; auto-detected if unambiguous")
  parser.add_argument("--skip-update", action="store_true", help="skip the standalone repository update; builder enrollment still syncs (use --local-build for offline bootstrap)")
  parser.add_argument("--no-switch", action="store_true", help="generate and stage configuration without rebuilding")
  parser.add_argument("--enroll-builder", action="store_true", help="only enroll this existing VM's key; defaults to its current hostname")
  parser.add_argument("--local-build", action="store_true", help="skip builder enrollment and generate a standalone VM configuration")
  args = parser.parse_args(raw)
  args.interactive = not raw and sys.stdin.isatty()
  if args.enroll_builder:
    if args.local_build or args.static_ip or args.gateway or args.dns or args.interface or args.no_switch or args.suggest_ip:
      parser.error("--enroll-builder cannot be combined with network, local-build, suggestion, or switch options")
    args.hostname = args.hostname or socket.gethostname().split(".")[0]
  if args.suggest_ip:
    if list(raw) != ["--suggest-ip"]:
      parser.error("--suggest-ip must be used by itself")
    return args
  if not args.hostname and sys.stdin.isatty():
    args.hostname = input("New VM hostname: ").strip()
  if not args.hostname:
    parser.error("hostname is required (or provide it at an interactive TTY)")
  if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", args.hostname):
    parser.error("hostname must be 1–63 lowercase letters, digits, or interior hyphens")
  if args.hostname in {"localhost", "nixos-base", "proxmox-base", "template", "common"}:
    parser.error("hostname is reserved")
  try:
    if args.static_ip and args.static_ip != "auto":
      validate_network(args)
    elif not args.static_ip and (args.gateway or args.dns or args.interface):
      parser.error("--gateway, --dns, and --interface require --static-ip")
    if args.interface and not re.fullmatch(r"[a-zA-Z0-9_.:-]{1,15}", args.interface):
      parser.error("invalid interface name")
  except ValueError as error:
    parser.error(str(error))
  return args


def validate_network(args):
  if "/" not in args.static_ip:
    raise ValueError("--static-ip must include a prefix length")
  address = ipaddress.IPv4Interface(args.static_ip)
  if address.ip.is_unspecified or address.ip.is_multicast or address.ip.is_loopback:
    raise ValueError("static address must be a unicast guest address")
  if address.network.prefixlen < 31 and address.ip in {address.network.network_address, address.network.broadcast_address}:
    raise ValueError("static address cannot be the subnet or broadcast address")
  if args.gateway:
    gateway = ipaddress.IPv4Address(args.gateway)
    if gateway not in address.network or gateway == address.ip:
      raise ValueError("gateway must be a different address in the guest subnet")
    if gateway.is_unspecified or gateway.is_multicast or gateway.is_loopback:
      raise ValueError("gateway must be a unicast address")
    if address.network.prefixlen < 31 and gateway in {address.network.network_address, address.network.broadcast_address}:
      raise ValueError("gateway cannot be the subnet or broadcast address")
  for dns in args.dns:
    server = ipaddress.ip_address(dns)
    if server.is_unspecified or server.is_multicast:
      raise ValueError("DNS servers must be unicast addresses")


def load_inventory(repo):
  path = repo / "lab/network.json"
  try:
    inventory = json.loads(path.read_text(), object_pairs_hook=unique_json_keys)
    subnet = ipaddress.IPv4Network(inventory["subnet"])
    ranges = []
    for name in ("dhcp_range", "static_range"):
      if not all(isinstance(inventory[name][key], str) for key in ("start", "end")):
        raise ValueError(f"{name} addresses must be strings")
      start = ipaddress.IPv4Address(inventory[name]["start"])
      end = ipaddress.IPv4Address(inventory[name]["end"])
      if start not in subnet or end not in subnet or start > end:
        raise ValueError(f"invalid {name}")
      if start == subnet.network_address or end == subnet.broadcast_address:
        raise ValueError(f"{name} includes a subnet or broadcast address")
      ranges.append((int(start), int(end)))
    if max(pair[0] for pair in ranges) <= min(pair[1] for pair in ranges):
      raise ValueError("DHCP and static ranges overlap")
    if not isinstance(inventory["gateway"], str):
      raise ValueError("gateway must be an IP address string")
    gateway = ipaddress.IPv4Address(inventory["gateway"])
    if gateway not in subnet or gateway in {subnet.network_address, subnet.broadcast_address}:
      raise ValueError("invalid gateway")
    if not isinstance(inventory["dns"], list) or not inventory["dns"]:
      raise ValueError("DNS must be a nonempty list")
    for server in inventory["dns"]:
      if not isinstance(server, str):
        raise ValueError("DNS servers must be IP address strings")
      address = ipaddress.ip_address(server)
      if address.is_unspecified or address.is_multicast:
        raise ValueError("invalid DNS server")
    names = set()
    addresses = set()
    if not isinstance(inventory["machines"], list):
      raise ValueError("machines must be a list")
    for entry in inventory["machines"]:
      ip = entry["ip"]
      if not isinstance(ip, str):
        raise ValueError("machine IP must be an IPv4 address string")
      address = ipaddress.IPv4Address(ip)
      if str(address) != ip:
        raise ValueError(f"machine IP must be canonical: {ip}")
      if ip in addresses:
        raise ValueError(f"duplicate machine IP: {ip}")
      addresses.add(ip)
      if address.is_unspecified or address.is_multicast or address.is_loopback:
        raise ValueError(f"invalid allocation: {ip}")
      name = entry["hostname"]
      if not isinstance(name, str) or not name or name in names:
        raise ValueError(f"invalid or duplicate allocation hostname: {name}")
      if not isinstance(entry["comment"], str):
        raise ValueError(f"invalid machine comment: {ip}")
      names.add(name)
    return inventory
  except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
    raise BootstrapError(f"Invalid inventory {path}: {error}") from error


def suggest_ip(inventory):
  start = int(ipaddress.IPv4Address(inventory["static_range"]["start"]))
  end = int(ipaddress.IPv4Address(inventory["static_range"]["end"]))
  prefix = ipaddress.IPv4Network(inventory["subnet"]).prefixlen
  used = {entry["ip"] for entry in inventory["machines"]} | {inventory["gateway"], *inventory["dns"]}
  for value in range(start, end + 1):
    address = str(ipaddress.IPv4Address(value))
    if address not in used:
      return f"{address}/{prefix}"
  raise BootstrapError("No unrecorded addresses remain in the inventory's static range")


def configure_network(args, inventory):
  for entry in inventory["machines"]:
    ip = entry["ip"]
    if entry["hostname"] == args.hostname:
      raise BootstrapError(f"Hostname {args.hostname} is already recorded at {ip} in lab/network.json")
  if args.interactive:
    try:
      suggestion = suggest_ip(inventory)
    except BootstrapError:
      suggestion = None
    prompt = f"Static IPv4/prefix [{suggestion}] or 'dhcp': " if suggestion else "Static IPv4/prefix or 'dhcp' (static range full): "
    choice = input(prompt).strip()
    args.static_ip = None if choice.lower() == "dhcp" else choice or "auto"
  if not args.static_ip:
    return
  if args.static_ip == "auto":
    args.static_ip = suggest_ip(inventory)
  try:
    address = ipaddress.IPv4Interface(args.static_ip)
    subnet = ipaddress.IPv4Network(inventory["subnet"])
    if address.ip in subnet:
      if address.network != subnet:
        raise ValueError(f"homelab addresses must use subnet {subnet}")
      start = ipaddress.IPv4Address(inventory["static_range"]["start"])
      end = ipaddress.IPv4Address(inventory["static_range"]["end"])
      if not start <= address.ip <= end:
        raise ValueError(f"homelab static addresses must be in {start}–{end}, outside the DHCP pool")
      args.gateway = args.gateway or inventory["gateway"]
      args.dns = args.dns or list(inventory["dns"])
    if not args.gateway or not args.dns:
      raise ValueError("addresses outside the homelab subnet require explicit --gateway and --dns")
    validate_network(args)
  except ValueError as error:
    raise BootstrapError(str(error)) from error
  ip = str(address.ip)
  for entry in inventory["machines"]:
    if ip == entry["ip"]:
      raise BootstrapError(f"IP {ip} is already recorded for {entry['hostname']} ({entry['comment']}) in lab/network.json")
  if ip in {inventory["gateway"], *inventory["dns"]}:
    raise BootstrapError(f"IP {ip} is already used by an inventory gateway or DNS server")
  print(f"Static IP: {args.static_ip}; gateway: {args.gateway}; DNS: {', '.join(args.dns)}")


def reserve_ip(args, inventory):
  updated = dict(inventory)
  updated["machines"] = [*inventory["machines"], {
    "hostname": args.hostname,
    "ip": str(ipaddress.IPv4Interface(args.static_ip).ip),
    "comment": args.description,
  }]
  return json.dumps(updated, indent=2) + "\n"


def unique_json_keys(pairs):
  result = {}
  for key, value in pairs:
    if key in result:
      raise ValueError(f"duplicate JSON key: {key}")
    result[key] = value
  return result


def check_repository(repo, hostname, *, existing=False):
  for parent in (repo / "hosts", repo / "home/hosts"):
    if not parent.is_dir():
      raise BootstrapError(f"Missing repository directory: {parent}")
    if not existing and ((parent / hostname).exists() or (parent / hostname).is_symlink()):
      raise BootstrapError(f"Host already exists: {parent / hostname}")
  flake = (repo / "flake.nix").read_text()
  if flake.count("# NEW_HOST_SENTINEL") != 1:
    raise BootstrapError("flake.nix must contain exactly one NEW_HOST_SENTINEL comment")
  pattern = rf'nixosConfigurations\s*\.\s*(?:{re.escape(hostname)}|"{re.escape(hostname)}")\s*='
  if not existing and re.search(pattern, flake):
    raise BootstrapError(f"Flake already defines {hostname}")
  if run(["git", "status", "--porcelain", "--untracked-files=all"], cwd=repo).strip():
    raise BootstrapError("Checkout has local changes. Review and commit or stash them before bootstrap; nothing was discarded.")
  return flake


def builder_host_key(repo):
  return (repo / CLIENT_MODULE / "host-key.pub").read_text().strip()


def builder_spec(repo):
  encoded = base64.b64encode((builder_host_key(repo) + "\n").encode()).decode()
  return f"ssh-ng://remotebuild@{BUILDER} x86_64-linux {BUILDER_KEY} 2 1 benchmark,big-parallel - {encoded}"


def builder_public_key():
  # This is secret provisioning, not an imperative system configuration change.
  # Derive the public half from the private key so a stale .pub cannot be enrolled.
  run(["sudo", "-n", "sh", "-eu", "-c", '''
umask 077
install -d -m 0700 /root/.ssh
if [ ! -e /root/.ssh/builder ]; then
  if [ -e /root/.ssh/builder.pub ]; then
    echo "builder.pub exists without its private key; resolve this before enrollment" >&2
    exit 1
  fi
  ssh-keygen -q -t ed25519 -N '' -C nix-builder-client -f /root/.ssh/builder
fi
test -f /root/.ssh/builder
chmod 0600 /root/.ssh/builder
'''])
  key = run(["sudo", "-n", "ssh-keygen", "-y", "-P", "", "-f", BUILDER_KEY]).strip()
  if not re.fullmatch(r"ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\n]+)?", key):
    raise BootstrapError("Expected an unencrypted Ed25519 builder key")
  return " ".join(key.split()[:2]) + "\n"


def publish_builder_key(repo, hostname, public_key):
  relative = f"hosts/builder/client-keys/{hostname}.pub"
  target = repo / relative
  if target.is_symlink():
    raise BootstrapError(f"Refusing symlink at {relative}")
  if target.exists() and target.read_text().split()[:2] != public_key.split()[:2]:
    raise BootstrapError(f"{relative} already contains a different key; refusing to overwrite it")
  # Explicit upstream/refspec: never push other branches or tags. Unpublished
  # commits must contain only this enrollment, including retries after failures.
  branch = run(["git", "symbolic-ref", "--short", "HEAD"], cwd=repo).strip()
  remote = run(["git", "config", "--get", f"branch.{branch}.remote"], cwd=repo).strip()
  merge = run(["git", "config", "--get", f"branch.{branch}.merge"], cwd=repo).strip()
  if remote == "." or not merge.startswith("refs/heads/"):
    raise BootstrapError("Enrollment requires a remote upstream branch")
  run(["git", "fetch", "--", remote], cwd=repo)
  commits = run(["git", "rev-list", "@{upstream}..HEAD"], cwd=repo).splitlines()
  for commit in commits:
    paths = run(["git", "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", "-m", commit], cwd=repo).splitlines()
    if set(paths) - {relative}:
      raise BootstrapError("Unpublished commits contain changes beyond this public key. Publish or resolve them yourself before enrollment.")
  if not target.exists():
    target.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(target, public_key)
    run(["git", "add", "--", relative], cwd=repo)
    run(["git", "commit", "--only", "-m", f"Enroll {hostname} Nix builder key", "--", relative], cwd=repo)
  try:
    run(["git", "pull", "--rebase", "--no-autostash"], cwd=repo)
  except BootstrapError as error:
    raise BootstrapError(f"Enrollment rebase failed. Resolve it in this checkout, then rerun bootstrap.\n{error}") from error
  if not target.exists() or target.read_text().split()[:2] != public_key.split()[:2]:
    raise BootstrapError("The enrolled key changed during rebase; inspect the checkout before continuing")
  run(["git", "-c", "push.followTags=false", "push", "--", remote, f"HEAD:{merge}"], cwd=repo)


def check_builder_access(repo):
  # An actual ssh-ng handshake checks the intended account and daemon, not the
  # operator's administrator login. Pin the host key even before first switch.
  encoded = base64.b64encode((builder_host_key(repo) + "\n").encode()).decode()
  store = f"ssh-ng://remotebuild@{BUILDER}?" + urlencode({
    "ssh-key": BUILDER_KEY,
    "base64-ssh-public-host-key": encoded,
  })
  try:
    run(["sudo", "-n", "env", "NIX_SSHOPTS=-oBatchMode=yes -oIdentitiesOnly=yes -oStrictHostKeyChecking=yes -oConnectTimeout=10", "nix", "store", "info", "--store", store])
  except BootstrapError as error:
    detail = str(error)
    if "Permission denied" in detail:
      raise BootstrapError(f"Public key published, but the builder has not authorized it yet.\nOn {BUILDER}, run git pull --rebase and ./bin/switch in the repository.\nThen rerun the same bootstrap command (and enter the same hostname).") from error
    raise BootstrapError(f"Builder access check failed; fix DNS, connectivity, host-key verification, or the builder service before retrying.\n{detail}") from error


def enroll_builder(repo, hostname):
  if hostname == "builder":
    raise BootstrapError("The builder cannot enroll itself as a client")
  missing = [command for command in ("sudo", "ssh-keygen", "nix") if not shutil.which(command)]
  if missing:
    raise BootstrapError(f"Missing enrollment commands: {', '.join(missing)}")
  run(["sudo", "-n", "test", "-f", "/etc/NIXOS"])
  publish_builder_key(repo, hostname, builder_public_key())
  check_builder_access(repo)
  print(f"Builder access verified for {hostname}.")


def update_repository(repo):
  try:
    upstream = run(["git", "rev-parse", "--abbrev-ref", "@{upstream}"], cwd=repo).strip()
  except BootstrapError as error:
    raise BootstrapError("No upstream branch is configured. Set it explicitly, or use --skip-update to keep the current snapshot.") from error
  branch = run(["git", "symbolic-ref", "--short", "HEAD"], cwd=repo).strip()
  remote = run(["git", "config", "--get", f"branch.{branch}.remote"], cwd=repo).strip()
  run(["git", "fetch", "--", remote], cwd=repo)
  try:
    run(["git", "merge", "--ff-only", "--", upstream], cwd=repo)
  except BootstrapError as error:
    raise BootstrapError("Cannot fast-forward the checkout. Resolve divergence yourself, or use --skip-update after reviewing the current snapshot. No local commits were discarded.") from error


def detect_interface(requested):
  links = json.loads(run(["ip", "-json", "link", "show"]))
  available = {link["ifname"] for link in links if link["ifname"] != "lo"}
  if requested:
    if requested not in available:
      raise BootstrapError(f"Interface {requested} does not exist in this VM")
    return requested
  routes = json.loads(run(["ip", "-json", "-4", "route", "show", "default"]))
  candidates = {route["dev"] for route in routes if route.get("dev") in available}
  if len(candidates) == 1:
    return candidates.pop()
  if len(available) == 1:
    return available.pop()
  raise BootstrapError("Cannot select a unique guest interface; supply --interface with --static-ip")


def boot_configuration():
  if Path("/sys/firmware/efi").exists():
    mounts = json.loads(run(["findmnt", "--json", "--types", "vfat", "--output", "TARGET"]))
    targets = [entry["target"] for entry in mounts.get("filesystems", [])]
    if len(targets) != 1:
      raise BootstrapError("Expected exactly one mounted EFI system partition")
    return [
      "  boot.loader.systemd-boot.enable = true;",
      "  boot.loader.efi.canTouchEfiVariables = false;",
      f"  boot.loader.efi.efiSysMountPoint = {nix_string(targets[0])};",
    ]
  root = run(["findmnt", "--noheadings", "--output", "SOURCE", "/"]).strip().split("[")[0]
  devices = run(["lsblk", "--inverse", "--noheadings", "--raw", "--paths", "--output", "NAME,TYPE", root])
  disks = {line.split()[0] for line in devices.splitlines() if len(line.split()) == 2 and line.split()[1] == "disk"}
  if len(disks) != 1:
    raise BootstrapError("Cannot identify one BIOS boot disk from the root filesystem")
  disk = disks.pop()
  aliases = sorted(path for path in Path("/dev/disk/by-id").glob("*") if path.resolve() == Path(disk).resolve())
  target = str(aliases[0]) if aliases else disk
  return ["  boot.loader.grub.enable = true;", f"  boot.loader.grub.device = {nix_string(target)};"]


def configuration(args, boot, interface=None):
  lines = [
    "{...}: {",
    "  imports = [",
    "    ./hardware-configuration.nix",
    "    ../common/nixos-vm",
    "  ];",
    "",
    f"  networking.hostName = {nix_string(args.hostname)};",
    *boot,
    *(["  lab.nixBuildClient.enable = false;"] if args.local_build else []),
  ]
  if args.static_ip:
    address = ipaddress.IPv4Interface(args.static_ip)
    lines += [
      "",
      "  networking.useDHCP = false;",
      f"  networking.interfaces.{nix_string(interface)} = {{",
      "    useDHCP = false;",
      f"    ipv4.addresses = [{{ address = {nix_string(str(address.ip))}; prefixLength = {address.network.prefixlen}; }}];",
      "  };",
      f"  networking.defaultGateway = {{ address = {nix_string(args.gateway)}; interface = {nix_string(interface)}; }};",
      f"  networking.nameservers = [{' '.join(nix_string(dns) for dns in args.dns)}];",
    ]
  else:
    lines += ["  networking.useDHCP = true;"]
  # Description is a comment; prefix each line so it cannot inject Nix code.
  description = "\n".join(f"# {line}" for line in args.description.splitlines())
  return f"{description}\n" + "\n".join(lines) + "\n}\n"


def flake_entry(hostname):
  return f'''    nixosConfigurations.{hostname} = nixpkgs.lib.nixosSystem {{
      system = "x86_64-linux";
      specialArgs = {{inherit inputs;}};
      modules = [
        ./hosts/{hostname}/configuration.nix
        {{
          home-manager.users.dbalatero = import ./home/hosts/{hostname};
        }}
      ];
    }};

'''


def atomic_write(path, content):
  descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
  try:
    with os.fdopen(descriptor, "w") as stream:
      stream.write(content)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)
  finally:
    if os.path.exists(temporary):
      os.unlink(temporary)


def main(argv=None):
  args = arguments(argv)
  repo = Path(__file__).resolve().parent.parent
  try:
    if args.suggest_ip:
      print(suggest_ip(load_inventory(repo)))
      print("Suggestion only: checks this local inventory, not live devices or unpublished allocations. Nothing was reserved.", file=sys.stderr)
      return 0
    check_repository(repo, args.hostname, existing=args.enroll_builder)
    use_builder = not args.local_build and args.hostname != "builder"
    if args.enroll_builder or use_builder:
      # Enrollment precedes host generation and IP reservation. It always syncs
      # its public-key commit, even when --skip-update was supplied.
      enroll_builder(repo, args.hostname)
      if args.enroll_builder:
        print("VMs inherit the builder client configuration from common/nixos-vm. Run ./bin/switch on this VM to apply it.")
        return 0
    elif not args.skip_update:
      update_repository(repo)
    elif args.static_ip or args.interactive:
      print("Using --skip-update: duplicate checks use this local snapshot; newer or unpublished allocations may be missing.", file=sys.stderr)
    flake = check_repository(repo, args.hostname)
    inventory = load_inventory(repo)
    configure_network(args, inventory)
    required = ["git", "sudo", "nixos-generate-config", "nix-instantiate", "findmnt", "lsblk"]
    if args.static_ip:
      required.append("ip")
    if not args.no_switch:
      required.append("nixos-rebuild")
    missing = [command for command in required if not shutil.which(command)]
    if missing:
      raise BootstrapError(f"Missing required commands: {', '.join(missing)}")
    try:
      run(["sudo", "-n", "test", "-f", "/etc/nixos-vm/recovery-password.hash"])
    except BootstrapError as error:
      raise BootstrapError("This command must run inside a prepared NixOS VM with passwordless sudo and its recovery-password hash installed") from error
    boot = boot_configuration()
    interface = detect_interface(args.interface) if args.static_ip else None
    hardware = run(["sudo", "-n", "nixos-generate-config", "--show-hardware-config"])
    host = repo / "hosts" / args.hostname
    home = repo / "home/hosts" / args.hostname
    contents = {
      host / "configuration.nix": configuration(args, boot, interface),
      host / "hardware-configuration.nix": hardware,
      home / "default.nix": '{...}: {\n  imports = [../../modules/proxmox-vm];\n}\n',
    }
    lines = flake.splitlines(keepends=True)
    index = next(index for index, line in enumerate(lines) if "# NEW_HOST_SENTINEL" in line)
    lines.insert(index + 1, flake_entry(args.hostname))
    contents[repo / "flake.nix"] = "".join(lines)
    # Parse all generated Nix before changing the checkout.
    with tempfile.TemporaryDirectory(prefix="nixos-vm-bootstrap-") as temporary:
      for index, content in enumerate(contents.values()):
        candidate = Path(temporary) / f"{index}.nix"
        candidate.write_text(content)
        run(["nix-instantiate", "--parse", str(candidate)])
    host.mkdir()
    home.mkdir()
    if args.static_ip:
      contents[repo / "lab/network.json"] = reserve_ip(args, inventory)
    for path, content in contents.items():
      atomic_write(path, content)
    staged = [str(host), str(home), "flake.nix"]
    if args.static_ip:
      staged.append("lab/network.json")
    run(["git", "add", "--", *staged], cwd=repo)
    print(run(["git", "diff", "--cached", "--stat"], cwd=repo), end="")
    print(f"Review: git diff --cached\nCommit when ready: git commit -m 'Add {args.hostname} VM'\nPush when ready: git push")
    if args.static_ip:
      print("The IP allocation is staged in lab/network.json. Publish it before bootstrapping another clone; this is not a network-wide reservation or a UniFi change.")
    command = ["sudo", "-n", "nixos-rebuild", "switch", "--flake", f"{repo}#{args.hostname}"]
    if use_builder:
      # The generated client configuration is not active during the first build.
      command += ["--builders", builder_spec(repo), "--option", "builders-use-substitutes", "true", "--max-jobs", "1"]
    print("Rebuild command: " + shlex.join(command), flush=True)
    if args.no_switch:
      print("Apply when ready: " + shlex.join(command))
    else:
      # Stream build progress, preserving the generated files on failure.
      result = subprocess.run(command, cwd=repo)
      if result.returncode:
        raise BootstrapError("Rebuild failed. Generated configuration remains staged for review and correction; rerun the printed rebuild command after fixing it.")
    return 0
  except (BootstrapError, OSError, ValueError) as error:
    print(f"bootstrap-nixos-vm: {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
  sys.exit(main())
